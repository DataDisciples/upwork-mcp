# --- Upwork OAuth2 ---
# Apply for credentials at https://www.upwork.com/developer/keys/apply
# Approval can take up to 2 weeks. Once approved, complete the OAuth2
# authorization-code flow once to obtain ACCESS_TOKEN + REFRESH_TOKEN.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
UPWORK_ORG_UID=

# Optional. Path where rotated tokens are persisted across restarts.
# On Railway, mount a Volume at /data and leave this as the default.
# For local dev, leave empty to disable on-disk persistence.
UPWORK_TOKEN_FILE=/data/upwork_tokens.json

# Optional. Set to 'true' to enable binding mutations (send_message, respond_to_offer).
UPWORK_ALLOW_DESTRUCTIVE=false

# --- MCP transport (Railway) ---
# Use 'stdio' for local Claude Desktop / Cursor; 'http' for Railway.
MCP_TRANSPORT=stdio

# Required when MCP_TRANSPORT=http. See utilities/RAILWAY-DEPLOY.md.
AUTHKIT_DOMAIN=
MCP_BASE_URL=

# --- Domo (pipeline only) ---
DOMO_CLIENT_ID=
DOMO_CLIENT_SECRET=
# DOMO_API_HOST=api.domo.com
